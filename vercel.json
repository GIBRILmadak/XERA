{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": "client/dist",
    "functions": {
        "api/*.js": {
            "includeFiles": "client/dist/**"
        }
    },
    "rewrites": [
        { "source": "/sitemap.xml", "destination": "/api/sitemap" },
        { "source": "/api/:path*", "destination": "/api/router?path=:path*" },
        { "source": "/((?!api/|icons/|css/|js/|medias/|favicon.svg|manifest.json|robots.txt|sw.js).*)", "destination": "/index.html" }
    ],
    "crons": [
        {
            "path": "/api/cron/send-reminders",
            "schedule": "0 10 * * *"
        },
        {
            "path": "/api/cron/sweep-subscriptions",
            "schedule": "5 0 * * *"
        }
    ]
}
