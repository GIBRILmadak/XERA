{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "geolocation=(), payment=(), usb=()" }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache" }
            ]
        },
        {
            "source": "/(js|css|icons|medias)/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
                }
            ]
        }
    ],
    "rewrites": [
        { "source": "/sitemap.xml", "destination": "/api/sitemap" },
        { "source": "/api/:path*", "destination": "/api/router?path=:path*" },
        { "source": "/", "destination": "/api/home" },
        { "source": "/login", "destination": "/login.html" },
        { "source": "/profile", "destination": "/api/profile" },
        { "source": "/profile/:path*", "destination": "/api/profile" },
        { "source": "/pagepro", "destination": "/profile.html" },
        { "source": "/pagepro/:path*", "destination": "/profile.html" },
        { "source": "/analytics", "destination": "/analytics.html" },
        { "source": "/admin", "destination": "/admin.html" },
        { "source": "/badges-admin", "destination": "/badges-admin.html" },
        { "source": "/create-stream", "destination": "/create-stream.html" },
        {
            "source": "/creator-dashboard",
            "destination": "/creator-dashboard.html"
        },
        { "source": "/credits", "destination": "/credits.html" },
        { "source": "/stream", "destination": "/stream.html" },
        {
            "source": "/subscription-plans",
            "destination": "/subscription-plans.html"
        },
        {
            "source": "/subscription-payment",
            "destination": "/subscription-payment.html"
        },
        { "source": "/verification", "destination": "/verification.html" },
        { "source": "/404", "destination": "/404.html" }
    ],
    "crons": [
        {
            "path": "/api/cron/send-reminders",
            "schedule": "0 10 * * *"
        }
    ]
}
