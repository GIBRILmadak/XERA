# ============================================================
# XERA — Variables d'environnement SERVEUR
# Copiez ce fichier en .env et remplissez les valeurs manquantes
# ============================================================

# --- App ---
APP_BASE_URL=http://localhost:3000
PORT=5050
NODE_ENV=development

# --- Supabase (récupérez-les dans votre dashboard Supabase > Settings > API) ---
SUPABASE_URL=https://ssbuagqwjptyhavinkxg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=VOTRE_SERVICE_ROLE_KEY_ICI

# --- Web Push / VAPID (générez-les avec: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=VOTRE_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=VOTRE_VAPID_PRIVATE_KEY
PUSH_CONTACT_EMAIL=mailto:hello@xera1.xyz

# --- Rappels push (heures séparées par virgule, format 24h) ---
RETURN_REMINDER_HOURS=10,18
RETURN_REMINDER_WINDOW_MINUTES=15
RETURN_REMINDER_SWEEP_MS=60000
