# Required server configuration. Never commit real values to Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-rotated-service-role-key
APP_BASE_URL=https://your-domain.example
SUPER_ADMIN_ID=your-supabase-auth-user-id
CRON_SECRET=generate-a-long-random-secret

# Web Push (optional: leave both empty to disable push delivery)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=mailto:security@your-domain.example

# Required when OAuth integrations are enabled
OAUTH_TOKEN_ENCRYPTION_KEY=32-byte-hex-or-base64-key

# Payment credentials, only if payment features are enabled
KPAY_PUBLIC_KEY=
KPAY_SECRET_KEY=
KPAY_CALLBACK_SECRET=
